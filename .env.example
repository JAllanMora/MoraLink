# Supabase (local: `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para scripts/cargar-cliente.mjs. Nunca en el navegador ni en Vercel.
SUPABASE_SECRET_KEY=

# Protege POST /api/revalidate
REVALIDATE_SECRET=
# URL de la app desplegada, para que cargar-cliente refresque el caché
MORALINK_APP_URL=

# WhatsApp de ventas en la landing de MoraLink (opcional)
NEXT_PUBLIC_CONTACT_WHATSAPP=
